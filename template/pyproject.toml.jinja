[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["{{ environment_name }}"]

[project]
name = "{{ environment_name }}"
version = "0.0.1"
requires-python = ">=3.11"
classifiers = ["Programming Language :: Python :: 3.15"]
dependencies = [
  "gymnasium",
  "pygame-ce>=2.5.0",
  "pre-commit",
]
